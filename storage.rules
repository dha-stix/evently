rules_version = '2';

// Deploy with: firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    match /events/{eventId}/cover {
      allow read: if true;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/events/$(eventId)).data.ownerId == request.auth.uid
        && (request.resource == null
            || (request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*')));
    }
  }
}
