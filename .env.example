# Copy this file to .env.local and fill in your values.

# Firebase → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: EmailJS (https://www.emailjs.com) for ticket confirmation emails.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=


# Optional: Google Maps Embed API key for venue maps (Google Cloud → APIs → "Maps Embed API").
# Restrict it to your domains (HTTP referrers). Without it, venues show "Open in Google Maps" links.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyDE3QoABQ10CQfrIB-TtocQkRc6OUbab4A

# Recommended: Firebase App Check with reCAPTCHA v3 (blocks scripted spam registrations).
# Create a reCAPTCHA v3 site key at https://www.google.com/recaptcha/admin, then register it in
# Firebase → App Check. Optionally pin a debug token for localhost.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
