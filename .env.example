# Copy this file to .env.local and fill in your values.

# Firebase → Project settings → General → Your apps → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: EmailJS (https://www.emailjs.com) for ticket confirmation emails.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=


# Optional: Google Maps Embed API key for venue maps (Google Cloud → APIs → "Maps Embed API").
# Restrict it to your domains (HTTP referrers). Without it, venues show "Open in Google Maps" links.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Recommended: Firebase App Check with reCAPTCHA (blocks scripted spam registrations).
# Create a score-based "Website" key in Google Cloud console → Security → reCAPTCHA (same project as
# Firebase; don't add localhost), then register it in Firebase → App Check with the
# "reCAPTCHA Enterprise" provider. Locally, use a debug token instead (below).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Your live site URL (no trailing slash), used for link previews. On Vercel this is detected automatically.
NEXT_PUBLIC_SITE_URL=
